[
  {
    "label": "copy .env into new worktree",
    "command": "cp",
    "args": [
      "$ZED_MAIN_GIT_WORKTREE/apps/server/.dev.vars",
      "$ZED_WORKTREE_ROOT/.dev.vars"
    ],
    "hooks": ["create_worktree"],
    "reveal": "no_focus",
    "hide": "on_success"
  },
  {
    "label": "Install deps",
    "env": {
      "NX_NON_INTERACTIVE": "true"
    },
    "hooks": ["create_worktree"],
    "command": "npm i",
    "hide": "on_success"
  },
  {
    "label": "Build",
    "env": {
      "NX_NON_INTERACTIVE": "true"
    },
    "hooks": ["create_worktree"],
    "command": "npm run :build",
    "hide": "on_success"
  },
  {
    "label": "Setup local db",
    "env": {
      "NX_NON_INTERACTIVE": "true"
    },
    "hooks": ["create_worktree"],
    "command": "npm run db:init:local",
    "hide": "on_success"
  }
]
