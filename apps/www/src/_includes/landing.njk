---
layout: base.njk
---
{%- set t = strings[lang] -%}
{%- set appHref = site.appUrl + ('/he' if lang == 'he' else '') -%}
<section class="hero">
  <div class="hero-inner">
    <p class="eyebrow">{{ t.eyebrow }}</p>
    <div class="about">
      {{ content | safe }}
    </div>
    <div class="cta">
      <a class="btn btn-cta" href="{{ appHref }}/join">{{ t.ctaJoin }}</a>
      <p class="cta-note">{{ t.ctaNote }}</p>
    </div>
  </div>
</section>

<section class="how">
  <div class="how-inner">
    <article class="step">
      <span class="step-num">1</span>
      <h3>{{ t.step1Title }}</h3>
      <p>{{ t.step1Body }}</p>
    </article>
    <article class="step">
      <span class="step-num">2</span>
      <h3>{{ t.step2Title }}</h3>
      <p>{{ t.step2Body }}</p>
    </article>
    <article class="step">
      <span class="step-num">3</span>
      <h3>{{ t.step3Title }}</h3>
      <p>{{ t.step3Body }}</p>
    </article>
  </div>
</section>
