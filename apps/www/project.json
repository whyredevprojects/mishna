{
  "name": "www",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/www/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "npx @11ty/eleventy", "cwd": "apps/www" },
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/_site"],
      "cache": true
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": { "command": "npx @11ty/eleventy --serve", "cwd": "apps/www" }
    },
    "deploy": {
      "executor": "@naxodev/nx-cloudflare:deploy",
      "dependsOn": ["build"]
    },
    "deploy-staging": {
      "executor": "@naxodev/nx-cloudflare:deploy",
      "dependsOn": ["build"],
      "options": { "env": "staging" }
    }
  }
}
