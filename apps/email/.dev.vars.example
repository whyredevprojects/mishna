# Local secrets for `wrangler dev` (read from .dev.vars, NOT .env).
# Copy this file to `.dev.vars` and fill in real values. `.dev.vars` is gitignored.
#
# Resend API key. Get one at https://resend.com/api-keys.
# Without it the queue sender's Resend call errors and the batch retries.
# For production set it with: wrangler secret put RESEND_API_KEY
RESEND_API_KEY=replace-me

# Optional local overrides for the vars in wrangler.toml. Defaults point at the
# production origin (which serves the mishna-text JSON) and the verified sender.
# APP_ORIGIN=http://localhost:4200
# RESEND_FROM_EMAIL=Chevra Mishnayos <onboarding@resend.dev>
