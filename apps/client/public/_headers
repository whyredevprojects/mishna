# Cloudflare Pages headers.
# The Angular service worker manifest and worker script must always be
# revalidated so a new deploy is picked up promptly (hashed JS/CSS bundles
# keep Pages' default immutable long-cache).
/ngsw.json
  Cache-Control: no-cache
/ngsw-worker.js
  Cache-Control: no-cache
/safety-worker.js
  Cache-Control: no-cache
/worker-basic.min.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/he/ngsw.json
  Cache-Control: no-cache
/he/ngsw-worker.js
  Cache-Control: no-cache
/he/safety-worker.js
  Cache-Control: no-cache
/he/worker-basic.min.js
  Cache-Control: no-cache
/he/manifest.he.webmanifest
  Cache-Control: no-cache
