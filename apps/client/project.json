{
  "name": "client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/client/src",
  "tags": [],
  "i18n": {
    "sourceLocale": "en-US",
    "locales": {
      "he": {
        "translation": "apps/client/src/locale/messages.he.xlf",
        "baseHref": "/he/"
      }
    }
  },
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/client",
        "browser": "apps/client/src/main.ts",
        "polyfills": ["@angular/localize/init"],
        "tsConfig": "apps/client/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "stylePreprocessorOptions": {
          "includePaths": ["apps/client/src"]
        },
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/client/public"
          },
          {
            "glob": "*.json",
            "input": "node_modules/mishna-text/data"
          }
        ],
        "styles": [
          "node_modules/@fontsource/frank-ruhl-libre/index.css",
          "node_modules/@awesome.me/webawesome/dist/styles/webawesome.css",
          "node_modules/@toast-ui/editor/dist/toastui-editor.css",
          "apps/client/src/styles.scss"
        ]
      },
      "configurations": {
        "production": {
          "deployUrl": "/",
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "900kb",
              "maximumError": "1.5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "apps/client/ngsw-config.json"
        },
        "production-he": {
          "localize": ["he"],
          "deployUrl": "/he/",
          "outputPath": "dist/apps/client-he",
          "index": {
            "input": "apps/client/src/index.he.html",
            "output": "index.html"
          },
          "i18nMissingTranslation": "error",
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "900kb",
              "maximumError": "1.5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "apps/client/ngsw-config.he.json"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/client/src/environments/environment.ts",
              "with": "apps/client/src/environments/environment.development.ts"
            }
          ]
        },
        "development-he": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "localize": ["he"],
          "index": {
            "input": "apps/client/src/index.he.html",
            "output": "index.html"
          },
          "fileReplacements": [
            {
              "replace": "apps/client/src/environments/environment.ts",
              "with": "apps/client/src/environments/environment.development.ts"
            }
          ]
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "client:build:production"
        },
        "development": {
          "buildTarget": "client:build:development"
        },
        "he": {
          "buildTarget": "client:build:development-he"
        }
      },
      "defaultConfiguration": "development",
      "dependsOn": ["server:serve", "login:serve"],
      "options": {
        "proxyConfig": "apps/client/proxy.conf.json"
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "client:build:development",
        "format": "xlf2",
        "outputPath": "apps/client/src/locale"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false,
        "runnerConfig": true,
        "setupFiles": ["apps/client/src/test-setup-i18n.ts"]
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "client:build",
        "port": 4200,
        "staticFilePath": "dist/apps/client/browser",
        "spa": true
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "npx nx build client --configuration=production-he",
          "rm -rf dist/apps/client/browser/he",
          "cp -r dist/apps/client-he/browser/he dist/apps/client/browser/he",
          "wrangler pages deploy dist/apps/client/browser --project-name=chevramishnayos --branch=main"
        ],
        "parallel": false
      }
    }
  }
}
