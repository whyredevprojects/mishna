{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/**",
          "/media/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    },
    {
      "name": "mishna-text",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/*.json"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-data",
      "urls": [
        "/api/me",
        "/api/me/chaluka",
        "/api/cycle",
        "/api/assignments",
        "/api/assignments?*",
        "/api/completions"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 50,
        "maxAge": "30d",
        "timeout": "3s"
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/he",
    "!/he/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/api/**"
  ]
}
